{
  "name": "@civ-clone/base-unit-action-sabotage-unit",
  "version": "0.1.0",
  "description": "The SabotageUnit unit action: a spy damages the lone unit of another player by a share of its hit points left, then escapes to its nearest city or is caught; with criteria for offering it.",
  "repository": "git@github.com:civ-clone/base-unit-action-sabotage-unit.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@civ-clone/core-player": "^0.1.10",
    "@civ-clone/core-terrain": "^0.1.4",
    "@civ-clone/core-yield": "^0.1.6",
    "@types/chai": "^4.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.0.0",
    "chai": "^4.0.0",
    "mocha": "^10.0.0",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.0.0"
  },
  "dependencies": {
    "@civ-clone/base-unit-agent": "^0.1.0",
    "@civ-clone/core-city": "^0.1.24",
    "@civ-clone/core-random": "^0.1.2",
    "@civ-clone/core-rule": "^0.1.9",
    "@civ-clone/core-unit": "^0.1.32",
    "@civ-clone/core-world": "^0.1.24"
  }
}
